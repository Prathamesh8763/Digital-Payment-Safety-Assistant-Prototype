# Digital Payment Safety Assistant - Environment Configuration
# Copy this file to .env for local adjustments (never commit .env)

# Backend Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Port
FRONTEND_PORT=5173

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
