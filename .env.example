# ClearPay - Digital Payment Safety Assistant (Root Environment Template)
# Copy this file to .env for local adjustments.
# NEVER commit real credentials or private keys to version control.

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Development Port
FRONTEND_PORT=5173

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional External AI Reasoning (Leave empty to use 100% deterministic local rule engine)
GEMINI_API_KEY=
